# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional custom base URL (e.g. for OpenRouter, Azure, or local proxy)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Slim Database path
DATABASE_FILE=slim.db

# Live conversation timing
# Delay in milliseconds between agent utterances to simulate live conversation
LIVE_DELAY_MS=1500

# Number of speaking turns per epoch before evolution phase
TURNS_PER_EPOCH=4

# Interval between epochs in seconds (0 = run once or wait for keypress)
EPOCH_INTERVAL_SEC=5
